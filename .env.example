# Aircall API Credentials
# Get these from: https://dashboard.aircall.io/integrations/api-keys
AIRCALL_API_ID=your_api_id_here
AIRCALL_API_TOKEN=your_api_token_here

# Optional: Enable read-only mode (default: false)
# AIRCALL_READ_ONLY=true

# Optional: Specific toolsets to enable (default: all)
# AIRCALL_TOOLS=calls,contacts,users
